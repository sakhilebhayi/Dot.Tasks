APP_NAME="Dot.Tasks"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tasks.infodot.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Generate a unique app id/key/secret per environment -- never reuse the
# same credentials across environments or across other Dot platforms:
#   php -r 'echo random_int(100000, 999999);'   # REVERB_APP_ID
#   php -r 'echo bin2hex(random_bytes(20));'     # REVERB_APP_KEY
#   php -r 'echo bin2hex(random_bytes(32));'     # REVERB_APP_SECRET
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Internal bind address/port for the reverb:start process itself, separate
# from the public REVERB_HOST/PORT/SCHEME above that browsers connect to
# through a reverse proxy in production. Unset in local dev (falls back to
# REVERB_HOST/PORT, fine with no proxy in front). See docs/DOT_REALTIME_STANDARD.md
# in the Dot.Mines repo (the ecosystem reference implementation) for why
# this split exists.
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ecosystem SSO: InfoDot proves handoff tokens (this app has its own database).
# INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_<KEY> in InfoDot's .env, and
# INFODOT_PLATFORM_KEY must be this platform's key there. Leave the secret blank to
# accept only tokens found in this app's own database (shared-database behaviour).
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=tasks
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Email via Dot.Notify (blank = nothing is sent). NOTIFY_INGEST_SECRET must equal
# NOTIFY_INGEST_SECRET_<PLATFORM KEY> in Dot.Notify's .env, and the company must enable the
# events in Notify. Needs a queue worker (php artisan queue:work).
NOTIFY_INGEST_URL=
NOTIFY_INGEST_SECRET=
NOTIFY_PLATFORM_KEY=tasks

# Daily aggregate metrics to Dot.Analytics (blank = nothing is sent). ANALYTICS_INGEST_URL is the full
# address ending /api/ingest/snapshots; ANALYTICS_INGEST_SECRET must equal ANALYTICS_INGEST_SECRET_<PLATFORM KEY>
# in Dot.Analytics' .env. Needs the scheduler (tasks:publish-metrics runs daily at 02:10 UTC) and a queue worker.
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=
ANALYTICS_PLATFORM_KEY=tasks

# Deleted tasks stay restorable (Removed page) for this many days; the daily tasks:purge-removed command then
# deletes them permanently. Minimum 1.
REMOVED_RETENTION_DAYS=90
